WORDPRESS_GRAPHQL_URL=https://your-wordpress-site.com/graphql
REVALIDATE_SECRET=change-me
# Must match the secret configured in the WordPress submissions plugin
WORDPRESS_SUBMIT_SECRET=change-me

# Login (email code)
AUTH_SECRET=generate-with-openssl-rand-base64-48
# Local only. Never set this on a deployed site; it is ignored for any host except localhost.
AUTH_DEV_MODE=false
# How login codes are emailed: "brevo" (free tier, recommended), "resend", or "wordpress"
# (uses your WordPress site's own mail, which needs an SMTP plugin on shared hosting).
EMAIL_PROVIDER=brevo
# Brevo: create an API key at app.brevo.com (SMTP & API > API keys).
BREVO_API_KEY=
# The sender shown on the email. Must be verified in Brevo (Senders, domains & dedicated IPs).
EMAIL_FROM=
EMAIL_FROM_NAME=House Hunt
# Resend alternative: RESEND_API_KEY=
